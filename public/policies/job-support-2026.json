{
  "policy": {
    "id": "job-support-2026",
    "slug": "job-support-2026",
    "title": "2026년 국민취업지원제도",
    "owner": "고용노동부",
    "source_url": "https://www.work24.go.kr",
    "source_published_at": "2026-01-01",
    "checked_at": "2026-08-16",
    "apply_url": "https://www.work24.go.kr",
    "disclaimer": "본 체크는 국민취업지원제도 공개 자료를 바탕으로 작성된 사전 확인용입니다. 참고용이며 법적 효력이 없습니다. 정확한 자격 여부는 반드시 고용24 또는 관할 고용센터(1350)에서 확인하시기 바랍니다."
  },
  "version": {
    "version_no": 1,
    "note": "2026년 기준"
  },

  "questions": [
    {
      "key": "job_status",
      "label": "현재 취업 상태가 어떻게 되시나요?",
      "help_text": "국민취업지원제도는 구직 의사가 있는 미취업자를 대상으로 합니다.",
      "type": "radio",
      "options": [
        { "value": "unemployed", "label": "미취업 상태이며 구직 중입니다" },
        { "value": "closed_biz", "label": "폐업한 소상공인·자영업자입니다" },
        { "value": "employed", "label": "현재 취업(재직) 중입니다" }
      ],
      "required": true,
      "order": 1
    },
    {
      "key": "age_range",
      "label": "나이가 어떻게 되시나요?",
      "type": "radio",
      "options": [
        { "value": "youth", "label": "만 15~34세 (군필자는 최대 만 37세)" },
        { "value": "adult", "label": "만 35~69세" },
        { "value": "over", "label": "만 70세 이상" }
      ],
      "required": true,
      "order": 2,
      "show_if": { "field": "job_status", "op": "neq", "value": "employed" }
    },
    {
      "key": "income_level",
      "label": "가구 소득 수준은 어디에 가까운가요?",
      "help_text": "청년(15~34세)은 중위소득 120% 이하, 일반(35세 이상)은 중위소득 60% 이하가 1유형 기준입니다.",
      "type": "radio",
      "options": [
        { "value": "low", "label": "기준 이하인 것 같습니다", "description": "청년: 중위소득 120% 이하 / 일반: 60% 이하" },
        { "value": "high", "label": "기준을 초과하는 것 같습니다" },
        { "value": "unsure", "label": "잘 모르겠습니다" }
      ],
      "required": true,
      "order": 3,
      "show_if": {
        "all": [
          { "field": "job_status", "op": "neq", "value": "employed" },
          { "field": "age_range", "op": "neq", "value": "over" }
        ]
      }
    },
    {
      "key": "asset_level",
      "label": "가구 재산이 기준 이하인가요?",
      "help_text": "청년은 5억원 이하, 일반은 4억원 이하입니다.",
      "type": "radio",
      "options": [
        { "value": "under", "label": "기준 이하입니다" },
        { "value": "over", "label": "기준을 초과합니다" },
        { "value": "unsure", "label": "잘 모르겠습니다" }
      ],
      "required": true,
      "order": 4,
      "show_if": {
        "all": [
          { "field": "job_status", "op": "neq", "value": "employed" },
          { "field": "age_range", "op": "neq", "value": "over" },
          { "field": "income_level", "op": "eq", "value": "low" }
        ]
      }
    },
    {
      "key": "special_group",
      "label": "다음 특정계층에 해당하시나요?",
      "help_text": "소득·재산 기준을 초과해도 특정계층이면 2유형으로 참여할 수 있습니다.",
      "type": "radio",
      "options": [
        { "value": "yes", "label": "해당됩니다", "description": "신용회복지원자, 미혼모·부, 노숙인, 결혼이민자, 북한이탈주민 등 약 20개 계층" },
        { "value": "no", "label": "해당하지 않습니다" },
        { "value": "unsure", "label": "잘 모르겠습니다" }
      ],
      "required": true,
      "order": 5,
      "show_if": {
        "all": [
          { "field": "job_status", "op": "neq", "value": "employed" },
          { "field": "age_range", "op": "neq", "value": "over" },
          { "field": "income_level", "op": "in", "value": ["high", "unsure"] }
        ]
      }
    }
  ],

  "rules": [
    {
      "priority": 10,
      "expression": { "field": "job_status", "op": "eq", "value": "employed" },
      "result_status": "likely_mismatch",
      "result_title": "재직 중에는 참여가 어렵습니다",
      "result_body": "국민취업지원제도는 구직 의사가 있는 미취업자를 대상으로 합니다. 재직 중이시라면 직업훈련이 필요할 때 '국민내일배움카드'를 확인해 보세요.",
      "evidence_text": "job_status = employed"
    },
    {
      "priority": 20,
      "expression": { "field": "age_range", "op": "eq", "value": "over" },
      "result_status": "needs_official_check",
      "result_title": "연령 기준(만 15~69세)을 확인해 주세요",
      "result_body": "국민취업지원제도는 만 15~69세를 대상으로 합니다. 만 70세 이상이신 경우 노인일자리 사업 등 다른 제도를 확인해 보세요.\n\n고용센터(1350)에서 맞춤 안내를 받으실 수 있습니다.",
      "evidence_text": "age_range = over"
    },
    {
      "priority": 100,
      "expression": {
        "all": [
          { "field": "income_level", "op": "eq", "value": "low" },
          { "field": "asset_level", "op": "eq", "value": "under" }
        ]
      },
      "result_status": "check_first",
      "result_title": "국민취업지원제도 1유형 확인 대상입니다",
      "result_body": "현재 공개 기준상 1유형(구직촉진수당 지급 대상)에 해당할 수 있습니다. 고용24에서 신청해 보세요.\n\n참고: 일반(만 35세 이상)은 최근 2년 내 취업 경험(100일 또는 800시간)이 필요하며, 청년은 취업 경험 없이도 신청 가능합니다.\n\n폐업 소상공인은 사업 운영 기간이 취업 경험으로 인정될 수 있습니다.",
      "limit_note": "구직촉진수당: 월 60만원×6개월 + 부양가족 1인당 월 10만원 | 성공수당: 근속 시 최대 150만원 | 신청: 고용24(work24.go.kr) 또는 고용센터",
      "evidence_text": "소득·재산 기준 충족"
    },
    {
      "priority": 110,
      "expression": { "field": "asset_level", "op": "in", "value": ["over", "unsure"] },
      "result_status": "needs_official_check",
      "result_title": "재산 기준 확인이 필요합니다",
      "result_body": "1유형은 재산 기준(청년 5억원, 일반 4억원 이하)을 충족해야 합니다. 기준을 초과하는 경우에도 2유형(취업지원서비스 중심)으로 참여할 수 있으니, 고용센터(1350)에서 확인해 보세요.",
      "evidence_text": "asset_level = over or unsure"
    },
    {
      "priority": 120,
      "expression": { "field": "special_group", "op": "eq", "value": "yes" },
      "result_status": "check_first",
      "result_title": "2유형 확인 대상입니다",
      "result_body": "소득·재산 기준을 초과해도 특정계층(신용회복지원자, 미혼모·부, 노숙인 등)에 해당하면 2유형으로 참여할 수 있습니다.\n\n2유형은 취업지원서비스와 취업활동비용 일부가 지원됩니다. 고용24 또는 고용센터에서 확인해 보세요.",
      "limit_note": "2유형: 취업지원서비스 + 취업활동비용 지원 | 신청: 고용24(work24.go.kr) 또는 고용센터(1350)",
      "evidence_text": "special_group = yes"
    },
    {
      "priority": 121,
      "expression": { "field": "special_group", "op": "in", "value": ["no", "unsure"] },
      "result_status": "needs_official_check",
      "result_title": "소득 기준과 유형 해당 여부를 확인해 주세요",
      "result_body": "소득 기준(청년 중위소득 120%, 일반 60% 이하) 충족 여부가 불확실한 경우, 고용센터(1350)에서 정확한 판정을 받아보시기 바랍니다. 기준 초과 시에도 2유형 참여 가능성이 있습니다.",
      "evidence_text": "special_group = no or unsure"
    },
    {
      "priority": 999,
      "expression": { "always": true },
      "result_status": "needs_official_check",
      "result_title": "공식 확인이 필요합니다",
      "result_body": "입력하신 조건만으로는 정확한 판단이 어렵습니다. 고용24 또는 관할 고용센터(1350)에 문의하여 확인하시기 바랍니다.",
      "evidence_text": "no rule matched"
    }
  ],

  "always_show_notes": [
    "이 체크는 공개 기준 사전 확인이며, 최종 참여 여부는 고용센터 심사로 결정됩니다.",
    "구직촉진수당 수급 중 소득이 발생하면 지급이 조정될 수 있습니다.",
    "1유형 일반 참여자는 최근 2년 내 취업 경험(100일 또는 800시간)이 필요합니다.",
    "신청: 고용24(work24.go.kr) | 방문: 관할 고용센터 | 문의: 1350"
  ],

  "cross_sell_note": "직업훈련이 필요하시다면 '국민내일배움카드' 30초 체크도 확인해 보세요. 폐업 소상공인이시라면 '새출발기금'과 '점포철거비 지원'도 함께 확인해 보세요.",

  "unknown_if": [
    "중위소득 기준액은 가구원 수에 따라 다르므로 정확한 판정은 고용센터에서 확인이 필요합니다",
    "취업 경험 인정 범위(사업 운영 기간 등)는 세부 심사 기준에 따릅니다"
  ],

  "test_cases": [
