      "answers": {
        "job_status": "unemployed",
        "age_range": "youth",
        "income_level": "low",
        "asset_level": "under"
      },
      "expected_status": "check_first"
    },
    {
      "name": "특정계층 2유형",
      "answers": {
        "job_status": "unemployed",
        "age_range": "adult",
        "income_level": "high",
        "special_group": "yes"
      },
      "expected_status": "check_first"
    },
    {
