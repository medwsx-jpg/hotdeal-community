    },
    {
      "key": "tax_delinquent",
      "label": "현재 국세를 체납 중인가요?",
      "type": "radio",
      "options": [
        { "value": "no", "label": "아니요, 체납이 없습니다" },
        { "value": "yes", "label": "네, 체납 중입니다" },
        { "value": "unsure", "label": "잘 모르겠음" }
      ],
      "required": true,
      "order": 4,
      "show_if": {
        "all": [
          { "field": "biz_status", "op": "eq", "value": "active" },
          { "field": "revenue_range", "op": "eq", "value": "in_range" },
          { "field": "industry_excluded", "op": "eq", "value": "no" }
