  "questions": [
    {
      "key": "biz_status",
      "label": "현재 사업장이 정상 운영 중인가요?",
      "help_text": "신청일 기준 휴업·폐업 상태가 아니어야 하며, 사업자등록증의 대표자와 신청자가 일치해야 합니다.",
      "type": "radio",
      "options": [
        { "value": "active", "label": "네, 정상 영업 중입니다" },
        { "value": "closed", "label": "휴업 또는 폐업 상태입니다" }
      ],
      "required": true,
      "order": 1
    },
    {
      "key": "revenue_range",
      "label": "2025년 연 매출액이 어느 범위인가요?",
      "help_text": "과세사업자는 부가가치세 신고내역, 면세사업자는 수입금액증명원 기준입니다.",
      "type": "radio",
      "options": [
        { "value": "in_range", "label": "0원 초과 ~ 1억 400만원 미만" },
        { "value": "over", "label": "1억 400만원 이상" },
        { "value": "zero", "label": "매출이 없습니다 (0원)" },
        { "value": "unsure", "label": "잘 모르겠습니다" }
      ],
      "required": true,
      "order": 2,
      "show_if": { "field": "biz_status", "op": "eq", "value": "active" }
    },
    {
      "key": "industry_excluded",
      "label": "운영 중인 업종이 지원제외 대상에 해당하나요?",
