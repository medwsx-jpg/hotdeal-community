  "rules": [
    {
      "priority": 10,
      "expression": { "field": "biz_status", "op": "eq", "value": "closed" },
      "result_status": "likely_mismatch",
      "result_title": "휴·폐업 상태에서는 신청이 어렵습니다",
      "result_body": "경영안정바우처는 신청일 기준 정상 영업 중인 소상공인을 대상으로 합니다. 휴업·폐업 상태인 경우 지원 대상에서 제외됩니다.\n\n폐업 후 재기를 준비 중이시라면 '희망리턴패키지'를 확인해 보세요.",
      "evidence_text": "biz_status = closed"
    },
    {
      "priority": 20,
      "expression": { "field": "revenue_range", "op": "eq", "value": "over" },
      "result_status": "likely_mismatch",
      "result_title": "매출 기준을 초과할 가능성이 있습니다",
      "result_body": "경영안정바우처는 2025년 연 매출액 1억 400만원 미만 소상공인을 대상으로 합니다. 매출이 기준을 초과하는 경우 지원 대상에 해당하지 않을 수 있습니다.\n\n정확한 기준은 소상공인24 공고문에서 확인하세요.",
      "evidence_text": "revenue_range = over"
    },
    {
      "priority": 21,
      "expression": { "field": "revenue_range", "op": "eq", "value": "zero" },
      "result_status": "needs_official_check",
      "result_title": "매출 0원인 경우 공식 확인이 필요합니다",
      "result_body": "매출 기준은 '0원 초과'로 공고되어 있어, 매출이 전혀 없는 경우 대상 여부 확인이 필요합니다. 소상공인24 또는 1357에 문의하세요.",
      "evidence_text": "revenue_range = zero"
