      "type": "radio",
      "options": [
        { "value": "no", "label": "해당 없음 (일반 업종)" },
        { "value": "yes", "label": "해당됨 (제외 업종)" },
        { "value": "unsure", "label": "잘 모르겠음" }
      ],
      "required": true,
      "order": 3,
      "show_if": {
        "all": [
          { "field": "biz_status", "op": "eq", "value": "active" },
          { "field": "revenue_range", "op": "eq", "value": "in_range" }
