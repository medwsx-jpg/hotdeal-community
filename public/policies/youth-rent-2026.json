  "questions": [
    {
      "key": "age_check",
      "label": "나이가 만 19세~34세인가요?",
      "type": "radio",
      "options": [
        { "value": "yes", "label": "네, 만 19~34세입니다" },
        { "value": "no", "label": "아니요, 범위 밖입니다" }
      ],
      "required": true,
      "order": 1
    },
    {
      "key": "living_status",
      "label": "부모님과 별도로 거주하는 무주택 세입자인가요?",
      "help_text": "본인 명의 주택이 없고, 부모와 떨어져 월세로 거주 중이어야 합니다.",
      "type": "radio",
      "options": [
        { "value": "yes", "label": "네, 독립해서 월세로 살고 있습니다" },
        { "value": "with_parents", "label": "부모님과 함께 살고 있습니다" },
        { "value": "own_house", "label": "본인 명의 주택이 있습니다" },
        { "value": "jeonse", "label": "전세로 살고 있습니다" }
      ],
      "required": true,
      "order": 2,
      "show_if": { "field": "age_check", "op": "eq", "value": "yes" }
    },
    {
      "key": "income_check",
      "label": "소득 기준을 충족하는 것 같나요?",
      "help_text": "청년 본인 가구 기준 중위소득 60% 이하, 부모 포함 원가구 기준 100% 이하가 기준입니다. (1인 가구 중위소득 60%는 월 약 140만원대)",
      "type": "radio",
      "options": [
        { "value": "under", "label": "기준 이하인 것 같습니다" },
        { "value": "over", "label": "기준을 초과하는 것 같습니다" },
        { "value": "unsure", "label": "잘 모르겠습니다" }
      ],
      "required": true,
      "order": 3,
      "show_if": {
        "all": [
          { "field": "age_check", "op": "eq", "value": "yes" },
          { "field": "living_status", "op": "eq", "value": "yes" }
        ]
      }
    }
  ],

  "rules": [
